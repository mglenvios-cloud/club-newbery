rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica si el usuario es administrador
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'ADMIN';
    }

    // Helper: Verifica si es el propio usuario/socio consultando su información
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. Colección de usuarios
    match /user/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // 2. Colección de socios
    match /member/{memberId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 3. Colección de tutores y carnets
    match /tutor/{tutorId} {
      allow read, write: if isAdmin();
    }
    match /digitalCard/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 4. Colecciones públicas (Sponsors, Noticias, Newbery TV, Liga Studio)
    match /sponsor/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /campaign/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /futsalNews/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /futsalMedia/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mediaFile/{fileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /video/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Reservas, Pagos, Facturas
    match /booking/{bookingId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if request.auth != null;
    }
    match /payment/{paymentId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if request.auth != null;
    }
    match /invoice/{invoiceId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Regla fallback por defecto para desarrollo
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
