{
  "services": {
    "club-digital-pro-backend": {
      "root": "backend",
      "entrypoint": "index.js",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "club-digital-pro-backend"
      }
    }
  ]
}
