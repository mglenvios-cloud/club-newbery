rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Archivos públicos (lectura libre) ─────────────────────────────────────
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Media del club (fotos, noticias, galería) ─────────────────────────────
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // ─── Videos de Newbery TV ──────────────────────────────────────────────────
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024; // 500 MB
    }

    // ─── Documentos de socios (acceso autenticado) ─────────────────────────────
    match /documentos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    // ─── Sponsors y banners ────────────────────────────────────────────────────
    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.role == 'ADMIN';
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.role == 'ADMIN';
    }

    match /campanas/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.role == 'ADMIN';
    }

    // ─── Bloquear todo lo demás ────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
