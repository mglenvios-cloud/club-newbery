# ─── Backend — Variables de Entorno (Club Digital Pro SaaS) ─────────────────

# Nombre de la aplicación SaaS
APP_NAME="Club Digital Pro"

# Puerto del servidor backend
PORT=5000

# Base de datos (SQLite local o PostgreSQL de producción)
DATABASE_URL="file:./dev.db"
# PostgreSQL Producción: DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secreto para firma de JWT (mínimo 32 caracteres)
JWT_SECRET="CAMBIAR_POR_SECRETO_SEGURO_32_CHARS_MINIMO"

# URL del Frontend para configuración de CORS
FRONTEND_URL="http://localhost:3000"

# Mercado Pago Access Token (Producción o Sandbox)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MP_ACCESS_TOKEN="APP_USR-..."

# Gemini AI API Key
GEMINI_API_KEY=""

# Entorno de ejecución
NODE_ENV="development"
