# ─── Backend — Variables de Entorno Requeridas ────────────────────────────────
# Copiar este archivo como .env y completar los valores

# Puerto del servidor (Render/Railway lo asigna automáticamente)
PORT=5000

# Base de datos (SQLite local o PostgreSQL en producción)
DATABASE_URL="file:./dev.db"
# Para PostgreSQL en producción usar:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret para firmar JWT — OBLIGATORIO, usar una clave larga y aleatoria
JWT_SECRET="CAMBIAR_POR_SECRETO_SEGURO_32_CHARS_MINIMO"

# URL del frontend para configuración de CORS — OBLIGATORIO
FRONTEND_URL="https://tu-proyecto.vercel.app"

# Mercado Pago — Access Token de producción
MP_ACCESS_TOKEN="APP_USR-..."

# Ambiente de ejecución
NODE_ENV="production"

# ─── Opcionales ───────────────────────────────────────────────────────────────

# Cloudinary (si se usa para uploads de imágenes)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Gemini AI (para el asistente IA)
# GEMINI_API_KEY=""
