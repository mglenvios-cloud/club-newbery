/**
 * ─── Backend — Variables de Entorno para Firebase ─────────────────────────────
 *
 * Copiar como .env para desarrollo local.
 * En producción (Cloud Functions), usar Firebase Secrets:
 *   firebase functions:secrets:set DATABASE_URL
 *   firebase functions:secrets:set DIRECT_URL
 *   firebase functions:secrets:set MP_ACCESS_TOKEN
 *   firebase functions:secrets:set GEMINI_API_KEY
 *   firebase functions:secrets:set FIREBASE_STORAGE_BUCKET
 *
 * Para desarrollo local con Firebase Admin SDK:
 *   Descargar service account desde Firebase Console → Configuración → Cuentas de servicio
 *   Guardar como backend/serviceAccount.json (está en .gitignore)
 *   Setear: GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
 */

# ─── Base de datos PostgreSQL (Supabase) ──────────────────────────────────────
# ⚠️ REEMPLAZAR: Connection String de Supabase → Settings → Database → URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.XXXXXXXXXX.supabase.co:5432/postgres?sslmode=require"

# URL directa para migraciones Prisma (sin connection pooler)
# ⚠️ REEMPLAZAR: Usar la "Direct connection" de Supabase (puerto 5432, no el pooler)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.XXXXXXXXXX.supabase.co:5432/postgres?sslmode=require"

# ─── JWT Secret (mantener durante la transición) ───────────────────────────────
# ⚠️ REEMPLAZAR: Mismo valor que tenías antes
JWT_SECRET="CAMBIAR_POR_EL_JWT_SECRET_ANTERIOR"

# ─── Firebase ──────────────────────────────────────────────────────────────────
# ⚠️ REEMPLAZAR: Nombre del bucket de Firebase Storage
# Formato: TU_PROJECT_ID.appspot.com  o  TU_PROJECT_ID.firebasestorage.app
FIREBASE_STORAGE_BUCKET="TU_PROJECT_ID.appspot.com"

# En desarrollo local: ruta al archivo serviceAccount.json
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"

# ─── MercadoPago ──────────────────────────────────────────────────────────────
# ⚠️ REEMPLAZAR: Tu Access Token real de MercadoPago
MP_ACCESS_TOKEN="APP_USR-TU_TOKEN_AQUI"

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# ⚠️ REEMPLAZAR: Tu API Key de Gemini (Google AI Studio)
GEMINI_API_KEY="TU_GEMINI_API_KEY_AQUI"

# ─── Servidor (solo para desarrollo local, no se usa en Cloud Functions) ───────
PORT=5000
NODE_ENV=development

# ─── Frontend URL (solo para CORS en desarrollo local) ────────────────────────
FRONTEND_URL=http://localhost:3000
